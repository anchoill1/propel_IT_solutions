# ============================================================
# Cinchify — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string
# Railway provides this automatically as DATABASE_URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/cinchify

# ── APP ──────────────────────────────────────────────────────
# The public URL of your deployed app (no trailing slash)
# Used for Stripe success/cancel redirect URLs and emails
APP_URL=https://yourapp.railway.app

# Port to listen on (Railway sets this automatically)
PORT=3000

# Set to "production" on Railway/Render
NODE_ENV=production

# ── STRIPE ───────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) during development
# Use live keys (sk_live_...) when going live
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# Webhook secret — get this from Stripe Dashboard > Webhooks
# Add endpoint: https://yourapp.railway.app/api/stripe/webhook
# Events to listen for: checkout.session.completed, customer.subscription.deleted, invoice.payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Stripe Price IDs — create products in Stripe Dashboard first
# Dashboard > Products > Add product > set recurring yearly price > copy price ID
STRIPE_PRICE_PRIMARY=price_PRIMARY_PLACEHOLDER
STRIPE_PRICE_SECONDARY=price_SECONDARY_PLACEHOLDER

# ── AI API KEYS ───────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com
# Schools can also supply their own key in the app settings
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY

# OpenAI (DALL-E image generation) — https://platform.openai.com/api-keys
# Schools supply their own key in the app settings — this is a server fallback
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY

# Pexels (photo search) — https://www.pexels.com/api/ (free)
PEXELS_API_KEY=YOUR_PEXELS_API_KEY

# ── EMAIL (cPanel SMTP) ───────────────────────────────────────
# Your cPanel host will give you these settings
# Usually found in cPanel > Email Accounts > Connect Devices
SMTP_HOST=mail.cinchify.ie
SMTP_PORT=587
# Set to true only if your host uses port 465 with SSL (rare for cPanel)
SMTP_SECURE=false
SMTP_USER=licences@cinchify.ie
SMTP_PASS=YOUR_EMAIL_PASSWORD
FROM_EMAIL=licences@cinchify.ie
